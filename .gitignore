# 本地工作脚本（非源码）
/*.bat
/*.ps1

# 便携版程序（不上传）
MyLauncherPortable/

# 发布产物（[R] 打包出的 zip，本地保留但不上传仓库）
Release/

# 插件构建产物（源码在 plugins-src/，运行时由打包目录加载，不进仓库）
plugins/

# 所有以 . 或 _ 开头的目录（.workbuddy/.temp/.vscode/.idea 等）
.*/
_*/

# 临时目录
test/

# node_modules
MyLauncher-src/node_modules/
node_modules/

# 构建输出
MyLauncher-src/dist/
dist/

# 编辑器临时文件
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 备份文件（*.bak / *.orig 等单文件备份）
*.bak
*.orig

# 备份归档目录（整批旧版本归档，如 _bak-archive-20261015/）
_bak-archive*/
bak-archive*/

# Rust 构建输出
MyLauncher-src/src-tauri/target/
target/
