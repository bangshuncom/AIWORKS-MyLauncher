{
  "api_version": 1,
  "id": "steam",
  "name": "Steam",
  "version": "1.0.0",
  "entry": "steam-scanner.exe",
  "priority": 0,
  "timeout_ms": 30000,
  "probe": {
    "dir_markers": ["steamapps"]
  },
  "installed_check": {
    "hive": "HKCU",
    "key": "Software\\Valve\\Steam",
    "value": "SteamPath"
  },
  "capabilities": ["scan_dir", "scan_id"]
}
